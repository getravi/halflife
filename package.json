{
  "name": "frontier-lab-plan",
  "version": "1.0.0",
  "private": true,
  "description": "52-week self-study tracker with a spaced-repetition review loop",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node tools/check.js",
    "render": "python3 tools/render.py",
    "gen": "node tools/build.js"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
