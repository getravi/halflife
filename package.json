{
  "name": "frontier-lab-plan",
  "version": "1.0.0",
  "private": true,
  "description": "52-week self-study tracker with a spaced-repetition review loop",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/validate-path.js && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:worker": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply frontier-lab --local",
    "db:migrate": "wrangler d1 migrations apply frontier-lab --remote",
    "deploy": "vite build && wrangler deploy",
    "validate": "node tools/validate-path.js",
    "links": "bash tools/link_check.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
